@model Ecommerce.BLL.Dtos.GetUserDto

@{
    ViewData["Title"] = "Update User";
}

<style>
    :root {
        --bg:          #0d0f14;
        --surface:     #13161e;
        --surface2:    #1a1e29;
        --border:      #252a38;
        --accent:      #4f7cff;
        --accent-glow: rgba(79,124,255,0.18);
        --text:        #e8eaf0;
        --muted:       #6b7494;
        --error:       #ff4f6a;
        --error-glow:  rgba(255,79,106,0.12);
    }

    body {
        background: var(--bg);
        font-family: 'DM Sans', sans-serif;
        color: var(--text);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .form-shell {
        width: 100%;
        max-width: 480px;
        animation: fadeUp 0.45s ease both;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--muted);
        font-size: 0.82rem;
        text-decoration: none;
        margin-bottom: 28px;
        transition: color 0.15s;
    }
    .back-link:hover { color: var(--text); }
    .back-link svg { width: 14px; height: 14px; }

    .form-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 36px 32px 32px;
        box-shadow: 0 24px 80px rgba(0,0,0,0.4);
        position: relative;
        overflow: hidden;
    }

    /* Accent glow blob */
    .form-card::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 200px; height: 200px;
        background: radial-gradient(circle, rgba(79,124,255,0.1) 0%, transparent 70%);
        pointer-events: none;
    }

    /* Current user badge */
    .current-user {
        display: flex;
        align-items: center;
        gap: 12px;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 28px;
    }

    .avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Syne', sans-serif;
        font-size: 0.78rem;
        font-weight: 800;
        color: #fff;
        flex-shrink: 0;
    }

    .current-user-label {
        font-size: 0.7rem;
        color: var(--muted);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .current-user-email {
        font-size: 0.85rem;
        color: var(--text);
        font-weight: 500;
        margin-top: 1px;
    }

    .form-title {
        font-family: 'Syne', sans-serif;
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        background: linear-gradient(135deg, #fff 40%, var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 6px;
    }

    .form-subtitle {
        font-size: 0.83rem;
        color: var(--muted);
        font-weight: 300;
        margin-bottom: 28px;
    }

    .section-label {
        font-family: 'Syne', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .section-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 20px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field label {
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--muted);
    }

    .field-wrapper {
        position: relative;
    }

    .field-wrapper svg {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        width: 15px; height: 15px;
        color: var(--muted);
        pointer-events: none;
        transition: color 0.2s;
    }

    .field input {
        width: 100%;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 11px 14px 11px 40px;
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }

    .field input::placeholder { color: #3a4155; }

    .field input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-glow);
        background: #161b28;
    }

    .field-wrapper:focus-within svg { color: var(--accent); }

    .field-validation-error {
        font-size: 0.75rem;
        color: var(--error);
    }

    input.input-validation-error {
        border-color: var(--error) !important;
        box-shadow: 0 0 0 3px var(--error-glow) !important;
    }

    .btn-row {
        display: flex;
        gap: 10px;
        margin-top: 4px;
    }

    .btn-submit {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--accent);
        color: #fff;
        font-family: 'Syne', sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        padding: 13px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        box-shadow: 0 0 28px var(--accent-glow);
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 36px rgba(79,124,255,0.4);
    }

    .btn-submit svg { width: 15px; height: 15px; }

    .btn-cancel {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--surface2);
        color: var(--text);
        font-family: 'Syne', sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        padding: 13px;
        border: 1px solid var(--border);
        border-radius: 10px;
        text-decoration: none;
        transition: background 0.15s, border-color 0.15s;
    }

    .btn-cancel:hover {
        background: var(--border);
        border-color: rgba(79,124,255,0.3);
        color: var(--text);
    }

    .btn-cancel svg { width: 15px; height: 15px; }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 480px) {
        .field-row { grid-template-columns: 1fr; }
        .form-card { padding: 28px 20px; }
        .btn-row { flex-direction: column; }
    }
</style>

<div class="form-shell">

    <a asp-action="ShowAll" class="back-link">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Users
    </a>

    <div class="form-card">

        <div class="current-user">
            <div class="avatar">
                @{
                    var parts = (Model.Fullname ?? "?").Split(' ');
                    var initials = string.Join("", parts.Take(2).Select(w => w.Length > 0 ? w[0].ToString().ToUpper() : ""));
                }
                @initials
            </div>
            <div>
                <div class="current-user-label">Editing account</div>
                <div class="current-user-email">@Model.Email</div>
            </div>
        </div>

        <h1 class="form-title">Update User</h1>
        <p class="form-subtitle">Change the name details below and save.</p>

        <form asp-action="UpdateUser" method="post" novalidate>

            <input type="hidden" name="email" value="@Model.Email" />

            <div class="section-label">New Details</div>

            <div class="field-row">
                <div class="field">
                    <label>First Name</label>
                    <div class="field-wrapper">
                        <input name="newFirstName" placeholder="John" />
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </div>
                </div>

                <div class="field">
                    <label>Last Name</label>
                    <div class="field-wrapper">
                        <input name="newLastName" placeholder="Doe" />
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="btn-row">
                <a asp-action="ShowAll" class="btn-cancel">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    Cancel
                </a>
                <button type="submit" class="btn-submit">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Changes
                </button>
            </div>

        </form>
    </div>
</div>
